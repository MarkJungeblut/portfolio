{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@portfolio/ui": ["./libs/ui/src/index.ts"],
      "@portfolio/utils": ["./libs/utils/src/index.ts"],
      "@portfolio/features/impressum": [
        "./libs/features/impressum/src/index.ts"
      ],
      "@portfolio/data": ["./libs/data/src/index.ts"],
      "@portfolio/features/home": ["./libs/features/home/src/index.ts"],
      "@portfolio/features/profile": ["./libs/features/profile/src/index.ts"],
      "@portfolio/features/skills": ["./libs/features/skills/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
